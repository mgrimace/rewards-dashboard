# Rewards Dashboard - copy to .env and edit.
# `npm start` loads this file automatically (--env-file-if-exists).

# --- required ---------------------------------------------------------------

# Where the bot's Control API (scripts/api/server.js) is listening.
#   same Docker network  ->  http://microsoft-rewards-script:3010
#   Control API on host  ->  http://host.docker.internal:3010
#   both on one machine  ->  http://127.0.0.1:3010
CONTROL_API_URL=http://127.0.0.1:3010

# Token used only when the dashboard connects to the Control API. It must
# exactly match the Control API's API_TOKEN. Leave it empty only when the
# Control API also runs without an API_TOKEN.
CONTROL_API_TOKEN=

# Optional browser login. Authentication is enabled only when BOTH values are
# non-empty. Leave either value empty to allow access without a login prompt.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- optional ---------------------------------------------------------------

# Port the dashboard listens on.
PORT=8890

# Timezone used to bucket points into days AND to evaluate the cron schedule.
# Set it, or your daily bars will roll over at the wrong hour.
TZ=Europe/Amsterdam

# Title shown in the header.
DASHBOARD_TITLE=Microsoft Rewards

# How often to poll the API for status (ms). Logs are streamed, not polled, so
# this can stay lazy.
POLL_MS=5000

# How many past log lines to ask the API for when the stream connects.
LOG_REPLAY=300

# Where dashboard.sqlite lives. This is the only folder anything writes to:
# point history, runs, activity and the schedule all live in it. The bot's
# Control API is stateless and keeps no files of its own.
DATA_DIR=./data

# --- notes on the Control API side ------------------------------------------
# Two tabs depend on flags set on the *API*, not here:
#   API_ALLOW_CONFIG_WRITE=true   -> Config tab can save (otherwise it's read-only)
#   API_ALLOW_CONFIG_REVEAL=true  -> Config tab can un-redact webhook secrets
